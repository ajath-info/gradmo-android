<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EdTech" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.EdTech" parent="Base.Theme.EdTech" />
    <style name="CommonButton1">
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingVertical">15dp</item>
        <item name="android:layout_marginHorizontal">20dp</item>
    </style>
    <style name="CommonButton2">
        <item name="cornerRadius">30dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:backgroundTint">@color/theme_blue</item>
        <item name="android:paddingVertical">15dp</item>
        <item name="android:layout_marginHorizontal">20dp</item>
    </style>
    <style name="CommonLoginFlowEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingVertical">13dp</item>
        <item name="android:paddingHorizontal">15dp</item>
        <item name="fontFamily">@font/manrope_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:background">@drawable/bg_login_flow_edittex</item>
    </style>
        <declare-styleable name="CustomRatingBar">
            <attr name="numStars" format="integer" />
            <attr name="rating" format="float" />
            <attr name="isIndicator" format="boolean" />
            <attr name="stepSize" format="float" />
            <attr name="starSize" format="dimension" />
            <attr name="starSpacing" format="dimension" />
        </declare-styleable>
    <style name="Theme.AppCompat.Translucent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AnswerOptionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textColor">@color/selector_answer_btn_text</item>
        <item name="backgroundTint">@color/selector_answer_btn_bg</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

</resources>