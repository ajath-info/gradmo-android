<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/color_present_bg_selected" />
            <stroke android:width="1.5dp" android:color="@color/theme_green" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/color_btn_default_bg" />
        </shape>
    </item>
</selector>