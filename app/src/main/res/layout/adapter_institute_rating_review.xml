<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="10dp"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_home_item"
        android:backgroundTint="@color/white">

        <androidx.cardview.widget.CardView
            android:id="@+id/instituteCardView"
            app:cardElevation="0dp"
            app:cardCornerRadius="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="60dp"
            android:layout_height="60dp">

            <ImageView
                android:id="@+id/profileImage"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/next_icon"
            android:rotation="180"
            android:src="@drawable/back_button"
            android:layout_marginEnd="16dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <TextView
            android:id="@+id/personName"
            app:layout_constraintEnd_toStartOf="@+id/next_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/instituteCardView"
            android:layout_marginHorizontal="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:fontFamily="@font/manrope_bold"
            android:textSize="13sp"
            android:text="Upgrade Classes" />
        <LinearLayout
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="8dp"
            android:id="@+id/starLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/next_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/instituteCardView"
            app:layout_constraintTop_toBottomOf="@+id/personName">
            <LinearLayout
                app:layout_constraintEnd_toEndOf="@id/instituteCardView"
                app:layout_constraintStart_toStartOf="@id/instituteCardView"
                app:layout_constraintTop_toBottomOf="@id/instituteCardView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/star_filled"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray"
                    android:fontFamily="@font/manrope_semibold"
                    android:textSize="11sp"
                    android:text="4.5" />

            </LinearLayout>
            <TextView
                android:layout_marginStart="30dp"
                android:id="@+id/ratingDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gray"
                android:fontFamily="@font/manrope_semibold"
                android:textSize="11sp"
                android:text="Feb, 20, 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTime"
            app:layout_constraintEnd_toStartOf="@+id/next_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/instituteCardView"
            app:layout_constraintTop_toBottomOf="@+id/starLayout"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:fontFamily="@font/manrope_regular"
            android:textSize="11sp"
            android:text="3:00 pm - 4:00 pm" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>