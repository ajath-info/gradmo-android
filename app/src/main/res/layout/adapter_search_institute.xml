<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_home_item"
        android:backgroundTint="@color/white">

        <androidx.cardview.widget.CardView
            android:id="@+id/instituteCardView"
            app:cardElevation="0dp"
            app:cardCornerRadius="50dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="83dp"
            android:layout_height="83dp">

            <ImageView
                android:id="@+id/image"
                android:scaleType="centerCrop"
                android:src="@drawable/onboarding3"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            app:layout_constraintEnd_toEndOf="@id/instituteCardView"
            app:layout_constraintStart_toStartOf="@id/instituteCardView"
            app:layout_constraintTop_toBottomOf="@id/instituteCardView"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/star_filled"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gray"
                android:fontFamily="@font/manrope_semibold"
                android:textSize="11sp"
                android:text="4.5" />

        </LinearLayout>

        <TextView
            android:id="@+id/instituteName"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/instituteCardView"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:fontFamily="@font/manrope_bold"
            android:textSize="17sp"
            android:text="Upgrade Classes" />
        <TextView
            android:id="@+id/instituteAddress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/instituteCardView"
            app:layout_constraintTop_toBottomOf="@+id/instituteName"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="9dp"
            android:drawableStart="@drawable/location_icon"
            android:drawablePadding="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:fontFamily="@font/manrope_regular"
            android:textSize="11sp"
            android:text="C-12, Pandara Road, Cannaught Place, New Delhi - 110001" />
        <TextView
            app:layout_constraintStart_toEndOf="@+id/instituteCardView"
            app:layout_constraintTop_toBottomOf="@+id/instituteAddress"
            android:background="@drawable/bg_blue_border"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="9dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/blue_3787FF"
            android:fontFamily="@font/manrope_semibold"
            android:textSize="10sp"
            android:text="Hybrid"
            android:paddingVertical="4dp"
            android:paddingHorizontal="15dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>