<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.get_started.fragment.GetStartedFragment">
        <ImageView
            android:src="@drawable/welcome_page_bg_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/registerAsStudent"/>
        <com.google.android.material.button.MaterialButton
            style="@style/CommonButton1"
            android:id="@+id/registerAsStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register As a Student"
            android:backgroundTint="@color/theme_blue"
            android:layout_marginBottom="3dp"
            app:layout_constraintBottom_toTopOf="@id/registerAsTeacher"/>
        <com.google.android.material.button.MaterialButton
            style="@style/CommonButton1"
            android:id="@+id/registerAsTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register As a Teacher"
            android:backgroundTint="@color/theme_red"
            android:layout_marginBottom="3dp"
            app:layout_constraintBottom_toTopOf="@id/registerAsInstitute"/>
        <com.google.android.material.button.MaterialButton
            style="@style/CommonButton1"
            android:id="@+id/registerAsInstitute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register As a Institute"
            android:backgroundTint="@color/theme_green"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>