<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.cardview.widget.CardView
        android:layout_marginBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        android:elevation="20dp"
        android:layout_marginHorizontal="8dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/videoCardView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintTop_toBottomOf="parent"
                app:cardCornerRadius="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="15dp"
                android:layout_width="match_parent"
                android:layout_height="177dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/batch_exam_image"/>
                    <ImageView
                        android:id="@+id/imageView"
                        android:scaleType="centerCrop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_marginHorizontal="15dp"
                app:layout_constraintBottom_toTopOf="@id/completedTag"
                app:layout_constraintTop_toBottomOf="@id/videoCardView"
                app:layout_constraintStart_toStartOf="parent"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/name"
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Newton’s First Law"
                    android:textColor="@color/black"
                    android:textSize="19sp"
                    android:fontFamily="@font/manrope_bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Questions : "
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope_bold"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                        <TextView
                            android:id="@+id/tvNoOfQuestions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="35"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope_regular"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duration : "
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope_bold"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30 mins"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:fontFamily="@font/manrope_regular"
                            android:maxLines="1"
                            android:ellipsize="end"/>
                    </LinearLayout>

                </LinearLayout>
                <LinearLayout
                    android:layout_weight="1"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complete By : "
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:fontFamily="@font/manrope_bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                    <TextView
                        android:id="@+id/tvCompletedBy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7:00 PM, Feb 24, 2026"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:fontFamily="@font/manrope_regular"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_weight="1"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/subjectName"
                        android:backgroundTint="@color/white"
                        app:cornerRadius="20dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#0091FF"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Physics"
                        android:textColor="#0091FF"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope_medium"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tvGrade"
                        android:layout_marginStart="10dp"
                        android:backgroundTint="@color/white"
                        app:cornerRadius="20dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#FF7300"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="12th Grade"
                        android:textColor="#FF7300"
                        android:textSize="12sp"
                        android:fontFamily="@font/manrope_medium"
                        android:textAllCaps="false"
                        android:letterSpacing="0"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startAssessmentButton"
                    style="@style/CommonButton2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_marginTop="10dp"
                    android:text="Start Assessment" />
            </LinearLayout>
            <TextView
                android:visibility="gone"
                android:id="@+id/completedTag"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="#1EB67A"
                android:layout_marginTop="15dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Completed"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="@font/manrope_regular"
                android:paddingVertical="15dp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>