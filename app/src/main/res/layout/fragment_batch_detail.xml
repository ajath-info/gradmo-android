<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingTop="45dp"
            android:paddingBottom="15dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/back_button"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="Batch Details"
                android:textColor="@color/black"
                android:textSize="21sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.core.widget.NestedScrollView
            android:fillViewport="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/headerLayout"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/batchDetailLayout"
                    app:cardCornerRadius="15dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:padding="10dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:paddingBottom="20dp"
                        android:paddingHorizontal="15dp"
                        android:paddingTop="15dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_home_item"
                        android:backgroundTint="@color/white">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/instituteCardView"
                            app:cardElevation="0dp"
                            app:cardCornerRadius="50dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_width="83dp"
                            android:layout_height="83dp">

                            <ImageView
                                android:id="@+id/imageView"
                                android:scaleType="centerCrop"
                                android:src="@drawable/profile_placeholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            app:layout_constraintEnd_toEndOf="@id/instituteCardView"
                            app:layout_constraintStart_toStartOf="@id/instituteCardView"
                            app:layout_constraintTop_toBottomOf="@id/instituteCardView"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/star_filled"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/gray"
                                android:fontFamily="@font/manrope_semibold"
                                android:textSize="11sp"
                                android:text="4.5" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/instituteName"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/instituteCardView"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginTop="7dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:fontFamily="@font/manrope_bold"
                            android:textSize="17sp"
                            android:text="" />
                        <TextView
                            android:id="@+id/batchName"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/instituteCardView"
                            app:layout_constraintTop_toBottomOf="@+id/instituteName"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginTop="9dp"
                            android:drawableStart="@drawable/student_iocn"
                            android:drawablePadding="6dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:fontFamily="@font/manrope_bold"
                            android:textSize="11sp"
                            android:text="" />
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/teacherLayout"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/instituteCardView"                        app:layout_constraintTop_toBottomOf="@+id/batchName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/tvTeacherName"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginTop="9dp"
                                android:drawableStart="@drawable/user_iocn"
                                android:drawablePadding="6dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:fontFamily="@font/manrope_regular"
                                android:textSize="11sp"
                                android:text="" />
                            <TextView
                                android:id="@+id/tvTiming"
                                app:layout_constraintStart_toEndOf="@id/tvTeacherName"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginTop="9dp"
                                android:drawableStart="@drawable/clock_icon"
                                android:drawablePadding="6dp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:fontFamily="@font/manrope_regular"
                                android:textSize="11sp"
                                android:text="" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/subjectName"
                            app:layout_constraintStart_toEndOf="@+id/instituteCardView"
                            app:layout_constraintTop_toBottomOf="@+id/teacherLayout"
                            android:background="@drawable/bg_blue_border"
                            android:layout_marginHorizontal="10dp"
                            android:layout_marginTop="9dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/blue_3787FF"
                            android:fontFamily="@font/manrope_semibold"
                            android:textSize="10sp"
                            android:text="Physics"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="15dp"/>
                        <TextView
                            android:id="@+id/grade"
                            app:layout_constraintStart_toEndOf="@+id/subjectName"
                            app:layout_constraintTop_toBottomOf="@+id/teacherLayout"
                            android:background="@drawable/bg_orange_border"

                            android:layout_marginHorizontal="10dp"
                            android:layout_marginTop="9dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/orange_FF7300"
                            android:fontFamily="@font/manrope_semibold"
                            android:textSize="10sp"
                            android:text="12th Grade"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="15dp"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_marginTop="10dp"
                    android:id="@+id/recyclerBatchDetailItem"
                    android:layout_marginHorizontal="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@id/batchDetailLayout"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    android:orientation="vertical"/>
                <View
                    android:id="@+id/blurView"
                    android:elevation="10dp"
                    android:clickable="true"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="#40000000"
                    app:layout_constraintTop_toBottomOf="@id/batchDetailLayout"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>
        <com.google.android.material.button.MaterialButton
            style="@style/CommonButton1"
            android:backgroundTint="@color/theme_blue"
            android:id="@+id/enrollButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Enroll to Unlock"
            android:layout_margin="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>