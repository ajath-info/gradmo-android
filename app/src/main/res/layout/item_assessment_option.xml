<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/optionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <!-- Option Label Badge (A, B, C, D) -->
            <TextView
                android:id="@+id/tvOptionLabel"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_option_label"
                android:gravity="center"
                android:minHeight="56dp"
                android:fontFamily="@font/manrope_bold"
                android:textColor="@color/white"
                android:textSize="18sp"
                tools:text="A" />

            <!-- Option Text -->
            <TextView
                android:id="@+id/tvOptionText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/manrope_medium"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:text="Slowly and safely accelerate while steering in the direction of the skid" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</layout>